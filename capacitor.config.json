{
  "appId": "com.erenmaral.dokun",
  "appName": "Dokun",
  "webDir": "www",
  "backgroundColor": "#1d1838",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "errorPath": "webview-guncelle.html"
  },
  "android": {
    "allowMixedContent": true,
    "minWebViewVersion": 108
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
