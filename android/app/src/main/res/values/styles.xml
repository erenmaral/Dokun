<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Oyun her zaman koyu: pencere zemini (WebView 140 oncesinde kenar bosluklari ve durum cubugu arkasi), durum ve gezinme cubugu
             ayni koyu renk olsun; acik temada beyaz / gri bantlar ve gorunmeyen simgeler olmasin. Capacitor SystemBars eklentisi
             simge rengini capacitor.config.json'daki style=DARK ile acik yapar. -->
        <item name="android:windowBackground">@color/dokun_splash_bg</item>
        <item name="android:statusBarColor">@color/dokun_splash_bg</item>
        <item name="android:navigationBarColor">@color/dokun_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/dokun_splash_bg</item>
        <item name="android:navigationBarColor">@color/dokun_splash_bg</item>
        <!-- Android 12+ sistem acilis ekrani: koyu zemin + simge (simge dairesel maskeye gore olceklidir, bkz. store/build-icons.js) -->
        <item name="windowSplashScreenBackground">@color/dokun_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>